{
  "name": "react-starter",
  "version": "1.0.0",
  "keywords": [
    "react",
    "gh-pages",
    "typescript",
    "vite",
    "vitest",
    "css modules",
    "front-end",
    "yarn",
    "pwa"
  ],
  "homepage": "https://najwer23.github.io/react-starter/",
  "type": "module",
  "scripts": {
    "bench": "vitest bench",
    "build": "tsc --build --clean && vite build",
    "deploy": "yarn run build && gh-pages -d build && rimraf build",
    "format": "yarn exec biome check --write",
    "god": "ncu -u && yarn install && yarn run start",
    "preview": "yarn build && vite preview --open --host",
    "start": "vite --open --host",
    "test": "vitest",
    "sort": "npx sort-package-json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "najwer23morsels": "^1.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.17.1"
}
